{
  "uid": "reprocket_configure_app",
  "type": "app",
  "config": {
    "name": "Reputation Rocket Configure",
    "description": "Installs Reputation Rocket HubSpot setup: files, contacts, lead form, completion properties.",
    "distribution": "marketplace",
    "auth": {
      "type": "oauth",
      "redirectUrls": [
        "http://localhost:8888/api/configure/oauth-callback",
        "https://reputationrocket.ai/api/configure/oauth-callback"
      ],
      "requiredScopes": [
        "crm.schemas.contacts.write",
        "forms",
        "oauth",
        "crm.objects.contacts.write",
        "crm.objects.contacts.read",
        "files.read",
        "files.write",
        "files.delete"
      ],
      "optionalScopes": [],
      "conditionallyRequiredScopes": []
    },
    "permittedUrls": {
      "fetch": [
        "https://api.hubapi.com"
      ],
      "iframe": [],
      "img": []
    },
    "support": {
      "supportEmail": "edward@lean-labs.com"
    }
  }
}