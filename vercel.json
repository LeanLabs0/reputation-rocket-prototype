{
  "redirects": [
    {
      "source": "/configure",
      "destination": "/configure/",
      "permanent": true
    },
    {
      "source": "/demo",
      "destination": "/lean-labs/demo/",
      "permanent": true
    },
    {
      "source": "/demo/",
      "destination": "/lean-labs/demo/",
      "permanent": true
    },
    {
      "source": "/demo/:path*",
      "destination": "/lean-labs/demo/:path*",
      "permanent": true
    },
    {
      "source": "/eim-demo",
      "destination": "/eimmigration/demo/",
      "permanent": true
    },
    {
      "source": "/eim-demo/",
      "destination": "/eimmigration/demo/",
      "permanent": true
    },
    {
      "source": "/eim-demo/:path*",
      "destination": "/eimmigration/demo/:path*",
      "permanent": true
    },
    {
      "source": "/eimmigration",
      "destination": "/eimmigration/",
      "permanent": true
    },
    {
      "source": "/eimmigration/demo",
      "destination": "/eimmigration/demo/",
      "permanent": true
    },
    {
      "source": "/katapult",
      "destination": "/katapult/",
      "permanent": true
    },
    {
      "source": "/lean-labs",
      "destination": "/lean-labs/",
      "permanent": true
    },
    {
      "source": "/lean-labs/demo",
      "destination": "/lean-labs/demo/",
      "permanent": true
    },
    {
      "source": "/propertyradar",
      "destination": "/propertyradar/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(self), geolocation=()"
        }
      ]
    }
  ]
}
