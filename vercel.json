{
  "redirects": [
    {
      "source": "/configure",
      "destination": "/configure/",
      "permanent": true
    },
    {
      "source": "/demo",
      "destination": "/lean-labs/demo/",
      "permanent": true
    },
    {
      "source": "/demo/",
      "destination": "/lean-labs/demo/",
      "permanent": true
    },
    {
      "source": "/demo/:path*",
      "destination": "/lean-labs/demo/:path*",
      "permanent": true
    },
    {
      "source": "/eim-demo",
      "destination": "/eimmigration/demo/",
      "permanent": true
    },
    {
      "source": "/eim-demo/",
      "destination": "/eimmigration/demo/",
      "permanent": true
    },
    {
      "source": "/eim-demo/:path*",
      "destination": "/eimmigration/demo/:path*",
      "permanent": true
    },
    {
      "source": "/eimmigration",
      "destination": "/eimmigration/",
      "permanent": true
    },
    {
      "source": "/eimmigration/demo",
      "destination": "/eimmigration/demo/",
      "permanent": true
    },
    {
      "source": "/katapult",
      "destination": "/katapult/",
      "permanent": true
    },
    {
      "source": "/lean-labs",
      "destination": "/lean-labs/",
      "permanent": true
    },
    {
      "source": "/lean-labs/demo",
      "destination": "/lean-labs/demo/",
      "permanent": true
    },
    {
      "source": "/propertyradar",
      "destination": "/propertyradar/",
      "permanent": true
    },
    {
      "source": "/propertyradar/demo",
      "destination": "/propertyradar/demo/",
      "permanent": true
    },
    {
      "source": "/pr-demo",
      "destination": "/propertyradar/demo/",
      "permanent": true
    },
    {
      "source": "/pr-demo/",
      "destination": "/propertyradar/demo/",
      "permanent": true
    },
    {
      "source": "/pr-demo/:path*",
      "destination": "/propertyradar/demo/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/pages/home/"
    },
    {
      "source": "/home.css",
      "destination": "/pages/home/home.css"
    },
    {
      "source": "/configure",
      "destination": "/pages/configure/"
    },
    {
      "source": "/configure/",
      "destination": "/pages/configure/"
    },
    {
      "source": "/configure/:path*",
      "destination": "/pages/configure/:path*"
    },
    {
      "source": "/eimmigration",
      "destination": "/pages/clients/eimmigration/"
    },
    {
      "source": "/eimmigration/",
      "destination": "/pages/clients/eimmigration/"
    },
    {
      "source": "/eimmigration/:path*",
      "destination": "/pages/clients/eimmigration/:path*"
    },
    {
      "source": "/lean-labs",
      "destination": "/pages/clients/lean-labs/"
    },
    {
      "source": "/lean-labs/",
      "destination": "/pages/clients/lean-labs/"
    },
    {
      "source": "/lean-labs/:path*",
      "destination": "/pages/clients/lean-labs/:path*"
    },
    {
      "source": "/propertyradar",
      "destination": "/pages/clients/propertyradar/"
    },
    {
      "source": "/propertyradar/",
      "destination": "/pages/clients/propertyradar/"
    },
    {
      "source": "/propertyradar/:path*",
      "destination": "/pages/clients/propertyradar/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(self), geolocation=()"
        }
      ]
    }
  ]
}
